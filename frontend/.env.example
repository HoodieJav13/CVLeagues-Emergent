# CVF Leagues — environment flags (copy to .env.local; never commit real keys)

# Supabase backend (Phase 9b). With BOTH set, the app runs against the real
# database (admin sign-in replaces the demo role switcher). With either
# missing, the app runs in mock mode: seed data + localStorage, no network.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Demo role-preview switcher in production builds (mock mode only; dev builds
# always include it). Leave unset for any real deployment.
# REACT_APP_SHOW_ROLE_SWITCHER=true
