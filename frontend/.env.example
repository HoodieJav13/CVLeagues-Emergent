# CVF Leagues — environment flags (copy to .env.local; never commit real keys)

# Supabase browser client. Both values are mandatory in preview/production.
# Local development uses mock/localStorage only when both are absent.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Public Cloudflare Turnstile site key. Mandatory in preview/production.
REACT_APP_TURNSTILE_SITE_KEY=

# Server-only Vercel Function values. Never prefix these with REACT_APP_ and
# never place real values in a committed file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
